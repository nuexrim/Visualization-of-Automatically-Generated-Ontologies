# 복사해서 .env 로 만들고 값을 채우세요. (.env 는 git에 올리지 않습니다)
ANTHROPIC_API_KEY=
AGENT_MODEL=
ONTOLOGY_GEN_MODEL=

# PostgreSQL
PGHOST=localhost
PGPORT=5433
# 관리자 계정 (복원, 스키마 추출용)
POSTGRES_USER=ontolens
POSTGRES_PASSWORD=change-me
# 에이전트 계정 (읽기 전용, SELECT만 가능)
AGENT_DB_USER=ontolens_agent
AGENT_DB_PASSWORD=change-me-too
